# Copy to .env and fill in. Never commit .env.

# --- Core
DEBUG=0
SECRET_KEY=change-me-to-a-long-random-string
SITE_URL=https://docfit.example.com
ALLOWED_HOSTS=docfit.example.com
CSRF_TRUSTED_ORIGINS=https://docfit.example.com

# --- Database (PostgreSQL in production; SQLite is used when empty)
# Set automatically by docker-compose.yml; only needed outside Docker
# DATABASE_URL=postgres://user:pass@host:5432/docfit

# --- Background jobs (Celery). Without REDIS_URL jobs run in a thread (dev only).
# REDIS_URL=redis://localhost:6379/0   (set automatically by docker-compose.yml)

# --- Storage for uploads and results (private, auto-deleted)
DOCFIT_STORAGE=/data/storage
MAX_UPLOAD_MB_HARD=500
# Threads used per job inside the engine
DOCFIT_THREADS=4

# --- Payments: Khalti ePayment v2 (https://admin.khalti.com). Empty = payments off.
KHALTI_SECRET_KEY=
# Sandbox: https://dev.khalti.com/api/v2/   Live: https://khalti.com/api/v2/
KHALTI_BASE_URL=https://dev.khalti.com/api/v2/

SUPPORT_EMAIL=support@docfit.example.com
DEMO_PASSWORD=docfit-demo-2026

# --- Docker Compose
DOMAIN=docfit.example.com
POSTGRES_PASSWORD=change-me
WORKER_CONCURRENCY=2

# --- Email for password reset (empty EMAIL_HOST = print emails to the console)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=DocFit <support@docfit.example.com>
